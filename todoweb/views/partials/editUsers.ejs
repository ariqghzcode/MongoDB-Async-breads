<%- include('../partials/header')%>
    <!-- Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editusers-form">
                    <input type="hidden" id="editusers-id" name="id">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="editModalLabel">Edit</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="card-body">
                            <div class="row mb-3">
                                <label for="title" class="col-sm-2 col-form-label">Name</label>
                                <div class="col-sm-10">
                                    <input class="form-control" type="text" id="edit-name" name="name"
                                        placeholder="edit your to do lists">
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <label for="title" class="col-sm-2 col-form-label">Phone</label>
                                <div class="col-sm-10">
                                    <input class="form-control" type="text" id="edit-phone" name="phone"
                                        placeholder="edit your to do lists">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success mb-0" type="submit">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <%- include('../partials/footer')%>