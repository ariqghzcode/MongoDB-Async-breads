<%- include('../partials/header')%>
    <div class="container">
        <div class="card mt-3">
            <div class="card-header text-center">
                <h1>Todo List</h1>
            </div>
            <div class="card-body">
                <form id="search-form">
                    <div class="row mb-3">
                        <label for="title" class="col-sm-2 col-form-label">Title</label>
                        <div class="col-sm-10">
                            <input class="form-control" type="text" id="title-search" name="title"
                                placeholder="insert title" value="">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="startdate" class="col-sm-2 col-form-label">Deadline</label>
                        <div class="col-sm-4">
                            <input class="form-control" type="date" id="startdate-search" name="startdate"
                                value="<%= query.startdate %>">
                        </div>
                        <label for="enddate" class="col-sm-1 col-form-label text-center">s.d.</label>
                        <div class="col-sm-4">
                            <input class="form-control" type="date" id="enddate-search" name="enddate"
                                value="<%= query.enddate %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="complete" class="col-sm-2 col-form-label">Complete</label>
                        <div class="col-sm-10">
                            <select id="complete-search" class="form-control" name="complete">
                                <option value="" disabled selected>-select complete-</option>
                                <option value="false">Not yet</option>
                                <option value="true">Done</option>
                            </select>
                        </div>
                    </div>
                    <button id="sort-deadline" class="btn btn-success me-5" type="button"><i id="sort-deadline-icon" class="fa-solid fa-sort"></i>sort by deadline</button>
                    <button class="btn btn-info" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    <button id="reset-search" class="btn btn-warning" type="button"><i
                            class="fa-solid fa-rotate"></i></button>
                </form>
                <hr>
                    <form id="quick-add-form" class="input-group flex-grow-1 w-auto" autocomplete="off">
                        <input class="form-control" type="text" id="title" name="title"
                                placeholder="title" value="">
                        <button class="btn btn-primary me-1" type="submit"><i class="fa-solid fa-plus"></i></button>
                    </form>
            </div>
                <div id="todo-list" class="px-3"></div>
                <div id="infinite-scroll-trigger"></div>
                <div id="loader" class="text-center text-muted py-3" style="display:none;">
                <i class="fa-solid fa-spinner fa-spin"></i> Memuat...
                </div>
                <div id="end-message" class="text-center text-muted py-3" style="display:none;">
                Semua data sudah ditampilkan.
                </div>
        </div>
    </div>

    
    <%- include('../partials/editForm') %>
        <script>
        const urlParams = new URLSearchParams(window.location.search)
        let params = {}

        if (urlParams.get('executor')) {
            params.executor = urlParams.get('executor')
        }

        const state = {
            page: 1,
            limit: 10,
            isLoading: false,
            hasMore: true
        }

        const listEl = document.getElementById('todo-list')
        const loaderEl = document.getElementById('loader')
        const endMsgEl = document.getElementById('end-message')
        const infiniteScrollTrigger = document.getElementById('infinite-scroll-trigger')

        const quickAddForm = document.getElementById('quick-add-form')
        quickAddForm.addEventListener('submit', function (event) {
            event.preventDefault()
            saveData()
        })

        const editModal = new bootstrap.Modal('#editModal', {
            keyboard: false
        })

        const editForm = document.getElementById('edit-form')
        editForm.addEventListener('submit', function (event) {
            event.preventDefault()
            updateData()
        })

        const searchForm = document.getElementById('search-form')
        searchForm.addEventListener('submit', function (event) {
            event.preventDefault()
            const title = document.getElementById('title-search').value
            const complete = document.getElementById('complete-search').value
            const startdate = document.getElementById('startdate-search').value
            const enddate = document.getElementById('enddate-search').value
            console.log(title, complete)
            params = { ...params, title, complete, startdate, enddate }
            resetAndLoad()
        })

        document.getElementById('reset-search').addEventListener('click', function (event) {
            document.getElementById('title-search').value = ''
            document.getElementById('complete-search').value = ''
            document.getElementById('startdate-search').value = ''
            document.getElementById('enddate-search').value = ''
            delete params.title
            delete params.complete
            delete params.startdate
            delete params.enddate
            resetAndLoad()
        })

        const sortButton = document.getElementById('sort-deadline')
        const sortIcon = document.getElementById('sort-deadline-icon')
        let sortState = { sortBy: 'id', sortMode: 'desc'}
        sortButton.addEventListener('click', function (event) {
            if (sortState.sortBy !== 'deadline') {
                sortState = {sortBy: 'deadline', sortMode: 'asc'}
            } else {
                sortState.sortMode = sortState.sortMode === 'asc' ? 'desc' : 'asc'
            }
            params = { ...params, sortBy: sortState.sortBy, sortMode: sortState.sortMode }
            sortIcon.className = sortState.sortMode === 'asc' ? 'fa-solid fa-sort-up' : 'fa-solid fa-sort-down'
            resetAndLoad()
        })

        const url = 'http://localhost:3000/'
        const renderItems = (items) => {
            const fragment =  document.createDocumentFragment()
            items.forEach((item) => {
                    const isOverdue = item.deadline && !item.complete && moment(item.deadline).isBefore(moment())
                    const wrapper = document.createElement('div')
                    wrapper.innerHTML = `<div class="alert ${isOverdue ? 'alert-danger' : item.complete ? 'alert-success' : 'alert-light'} d-flex justify-content-between align-items-center" role="alert"">
                                <span>${moment(item.deadline).format('D MMM YYYY HH:mm')} ${item.title}</span>
                                <span>
                                    <button class="btn btn-success" type="button" onclick="editData('${item._id}')"><i
                                            class="fa-solid fa-pencil"></i></button>
                                    <button class="btn btn-danger" type="button" onclick="deleteData('${item._id}')"
                                        onclick="return confirm('apakah anda yakin menghapus '${item._id}'')"><i
                                            class="fa-solid fa-trash"></i></button>
                                </span>
                            </div>`
                    fragment.appendChild(wrapper.firstElementChild)
                })
                listEl.appendChild(fragment)
        }

        const loadMore = async () => {
            if (state.isLoading || !state.hasMore) return

            state.isLoading = true
            loaderEl.style.display = 'block'

            try {
                const query = { ...params, page: state.page, limit: state.limit }
                Object.keys(query).forEach((key) => {
                    if (query[key] === '' || query[key] === undefined || query[key] === null) {
                        delete query[key]
                    }
                })

                const response = await fetch(`/api/todos?${new URLSearchParams(query)}`);
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();

                renderItems(result.data)
                state.page += 1 

                if (result.data.length < state.limit || state.page > result.pages) {
                    state.hasMore = false
                    endMsgEl.style.display = 'block'
                    observer.unobserve(infiniteScrollTrigger)
                }

            } catch (error) {
                console.error(error.message);
            } finally {
                state.isLoading = false
                loaderEl.style.display = 'none'
            }
        }

        const resetAndLoad = () => {
            state.page = 1
            state.hasMore = true
            listEl.innerHTML = ''
            endMsgEl.style.display = 'none'
            observer.observe(infiniteScrollTrigger)
            loadMore()
        }

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                loadMore()
            }
        }, {rootMargin: '200px'})

        observer.observe(infiniteScrollTrigger)

        resetAndLoad()

        const saveData = async () => {
            const title = document.getElementById('title').value
            try {
                const response = await fetch('/api/todos', {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ title, executor: params.executor })
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                document.getElementById('title').value = ''
                resetAndLoad()
            } catch (error) {
                console.error(error.message);
            }
        }

        const updateData = async () => {
            const id = document.getElementById('edit-id').value
            const title = document.getElementById('edit-title').value
            const deadline = document.getElementById('edit-deadline').value
            const complete = document.getElementById('edit-complete').value
            try {
                const response = await fetch(`/api/todos/${id}`, {
                    method: 'PUT',
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ title, deadline, complete })
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                resetAndLoad()
                editModal.hide()
            } catch (error) {
                console.error(error.message);
            }
        }

        const editData = async (id) => {
            try {
                const response = await fetch(`/api/todos/${id}`, {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json",
                    }
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                document.getElementById('edit-id').value = result._id
                document.getElementById('edit-title').value = result.title ?? ''
                document.getElementById('edit-deadline').value = result.deadline ? moment(result.deadline).format('YYYY-MM-DDTHH:mm') : ''
                document.getElementById('edit-complete').value = result.complete === null || result.complete === undefined ? '' : String(result.complete)
                editModal.show()
            } catch (error) {
                console.error(error.message);
            }
        }

        </script>
        <%- include('../partials/deleteConfirmation', { entity: 'todos', reloadFn: 'resetAndLoad' } )%>
            <%- include('../partials/footer')%>