<%- include('../partials/header')%>
<div class="container">
    <div class="card mt-3">
        <div class="card-header text-center">
            <h1>MongoDB Breads(Browse, Read, Edit, Add, Delete, Sort)</h1>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center mb-3 flex-wrap">
                <div class="input-group me-2" style="width: auto;">
                    <span class="input-group-text">Show</span>
                    <select id="show-entries" class="form-select" style="width:65px;">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="all">all</option>
                    </select>
                    <span class="input-group-text">entries</span>
                </div>

                <form id="search-form" class="input-group flex-grow-1 w-auto" autocomplete="off">
                    <input class="form-control" id="search" type="text" name="search" placeholder="Search" value="">
                    <button class="btn btn-info me-1" type="submit"><i
                            class="fa-solid fa-magnifying-glass"></i></button>
                    <button id="reset-search" class="btn btn-warning" type="button"><i
                            class="fa-solid fa-rotate"></i></button>
                </form>

            </div>
            <hr>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>No.</th>
                    <th><a
                            href="/users?<%= url.replace(`sortBy=${sortBy}`, `sortBy=name`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i
                                class="fa-solid fa-<%= `${sortBy == 'name' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Name</a>
                    </th>
                    <th><a
                            href="/users?<%= url.replace(`sortBy=${sortBy}`, `sortBy=name`).replace(`sortMode=${sortMode}`, `sortMode=${sortMode == 'asc' ? 'desc' : 'asc'}`) %>"><i
                                class="fa-solid fa-<%= `${sortBy == 'name' ? sortMode == 'asc' ? 'sort-up' : 'sort-down' : 'sort'}` %>"></i>Phone</a>
                    </th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody id="table-content">

            </tbody>
        </table>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <button id="add-button" type="button" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i></button>
            <nav aria-label="Page navigation example" id="pagination"></nav>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="user-form">
                <input type="hidden" id="id" name="id">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="formModalLabel">Add User</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="card-body">
                        <div class="row mb-3">
                            <label for="title" class="col-sm-2 col-form-label">Name</label>
                            <div class="col-sm-10">
                                <input class="form-control" type="text" id="name" name="name"
                                    placeholder="insert new users name">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="title" class="col-sm-2 col-form-label">Phone</label>
                            <div class="col-sm-10">
                                <input class="form-control" type="text" id="phone" name="phone"
                                    placeholder="insert phone number">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary mb-0" type="submit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
<%- include('../partials/editUsers') %>
    <script>
        const urlParams = new URLSearchParams(window.location.search)
        let params = {
            page: 1
        }
        if (urlParams.get('userid')) {
            params.userid = urlParams.get('userid')
        }

        const formModal = new bootstrap.Modal('#formModal', {
            keyboard: false
        })

        const userForm = document.getElementById('user-form')
        userForm.addEventListener('submit', function (event) {
            event.preventDefault()
            saveData()
        })

        const editModal = new bootstrap.Modal('#editModal', {
            keyboard: false
        })

        const editForm = document.getElementById('editusers-form')
        editForm.addEventListener('submit', function (event) {
            event.preventDefault()
            updateData()
        })

        const searchForm = document.getElementById('search-form')
        searchForm.addEventListener('submit', function (event) {
            event.preventDefault()
            const search = document.getElementById('search').value
            params = { ...params, search, page: 1 }
            loadData()
        })

        document.getElementById('reset-search').addEventListener('click', function (event) {
            document.getElementById('search').value = ''
            delete params.search
            params.page = 1
            loadData()
        })

        document.getElementById('add-button').addEventListener('click', function (event) {
            document.getElementById('id').value = ""
            document.getElementById('name').value = ""
            document.getElementById('phone').value = ""
            formModal.show()
        })

        const pagination = (page, pages) => {
            html = `<ul class="pagination mb-0">`
            if (page > 1) {
                html += `<li class="page-item">
                    <a class="page-link"
                        href="javascript:void(0)" 
                        onclick="changePage(${page - 1})"
                        aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>`
            }
            for (let i = 1; i <= pages; i++) {
                html += `<li class="page-item ${page == i ? ' active' : ''}">
                    <a class="page-link" href="javascript:void(0)" onclick="changePage(${i})">${i}</a>
                </li>`
            }
            if (page < pages) {
                html += `<li class="page-item">
                    <a class="page-link"
                        href="javascript:void(0)" 
                        onclick="changePage(${page + 1})"
                        aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>`
            }
            html += `</ul>`
            document.getElementById('pagination').innerHTML = html
            pagination(result.page, result.pages)
        }
        const url = 'http://localhost:3000/'
        const loadData = async () => {
            try {
                const response = await fetch(`/api/users?${new URLSearchParams(params)}`);
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                html = ''
                result.data.forEach((item, index) => {
                    html += `<tr>
                            <td>
                                ${index + 1}
                            </td>
                            <td>
                                ${item.name}
                            </td>
                            <td>
                                ${item.phone}
                            </td>
                            <td><button class="btn btn-success" type="button" onclick="editData('${item._id}')"><i
                                        class="fa-solid fa-pencil"></i></button>
                                <button class="btn btn-danger" type="button" onclick="deleteData('${item._id}')"
                                    onclick="return confirm('apakah anda yakin menghapus ${item._id}')"><i
                                        class="fa-solid fa-trash"></i></button>
                                <button class="btn btn-warning" type="button" onclick="goToTodos('${item._id}')"><i 
                                        class="fa-solid fa-right-to-bracket"></i></button>
                            </td>
                        </tr>`
                })
                document.getElementById('table-content').innerHTML = html
                pagination(result.page, result.pages)
            } catch (error) {
                console.error(error.message);
            }
        }
        loadData()

        const saveData = async () => {
            const name = document.getElementById('name').value
            const phone = document.getElementById('phone').value
            try {
                const response = await fetch('/api/users', {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ name, phone })
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                loadData()
                formModal.hide()
            } catch (error) {
                console.error(error.message);
            }
        }

        const updateData = async () => {
            const id = document.getElementById('editusers-id').value
            const name = document.getElementById('edit-name').value
            const phone = document.getElementById('edit-phone').value
            try {
                const response = await fetch(`/api/users/${id}`, {
                    method: 'PUT',
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ name, phone })
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                loadData()
                editModal.hide()
            } catch (error) {
                console.error(error.message);
            }
        }

        const changePage = (page) => {
            params = { ...params, page }
            loadData()
        }
        const goToTodos = (executor) => {
            window.location.href = `/todos?executor=${executor}`
        }

        const editData = async (id) => {
            try {
                const response = await fetch(`/api/users/${id}`, {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json",
                    }
                });
                if (!response.ok) {
                    throw Error(`Response status: ${response.status}`);
                }
                const result = await response.json();
                document.getElementById('editusers-id').value = result._id
                document.getElementById('edit-name').value = result.name ?? ''
                document.getElementById('edit-phone').value = result.phone ?? ''
                editModal.show()
            } catch (error) {
                console.error(error.message);
            }
        }

    </script>
    <%- include('../partials/deleteConfirmation', { entity: 'users' } )%>
        <%- include('../partials/footer')%>